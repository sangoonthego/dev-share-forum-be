generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

enum UserRole {
  ADMIN
  USER
}

model refresh_tokens {
  id         Int      @id @default(autoincrement())
  token      String   @unique // Hashed token
  user_id    Int      @unique
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  is_revoked Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_id])
  @@map("refresh_tokens")
}

model users {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  full_name     String?
  password_hash String
  role          UserRole  @default(USER)
  phone         String?
  profile_avatar String?  // Avatar URL/path
  karma         Int       @default(0)
  token_version Int       @default(1) // For password change revocation
  meta          Json?     @default("{}")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  posts    posts[]
  comments comments[]
  refresh_tokens refresh_tokens[]
  login_audits login_audits[]

  @@map("users")
}

model posts {
  id               Int      @id @default(autoincrement())
  title            String
  slug             String   @unique
  content_markdown String
  is_published     Boolean  @default(false)
  view_count       Int      @default(0)
  
  // Soft delete support
  deleted_at       DateTime?
  
  // Hỗ trợ AI Search (Vector 768 dimensions - chuẩn của model embedding phổ biến)
  embedding        Unsupported("vector(768)")? 

  author_id Int
  author    users @relation(fields: [author_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  comments    comments[]
  posts_tags  posts_tags[]

  @@index([deleted_at]) // For efficient soft delete filtering
  @@map("posts")
}

model comments {
  id        Int    @id @default(autoincrement())
  content   String
  
  post_id   Int
  post      posts @relation(fields: [post_id], references: [id])

  author_id Int
  author    users @relation(fields: [author_id], references: [id])

  parent_id Int?
  parent    comments? @relation("CommentReplies", fields: [parent_id], references: [id])
  replies   comments[] @relation("CommentReplies")

  // Soft delete support
  deleted_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("comments")
}

model tags {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  slug        String       @unique
  description String?
  posts_tags  posts_tags[]

  @@map("tags")
}

model posts_tags {
  post_id Int
  tag_id  Int
  post    posts @relation(fields: [post_id], references: [id])
  tag     tags  @relation(fields: [tag_id], references: [id])

  @@id([post_id, tag_id])
  @@map("posts_tags")
}

enum LoginStatus {
  SUCCESS
  FAILED
  BLOCKED // Rate limit
}

model login_audits {
  id        Int         @id @default(autoincrement())
  user_id   Int?        // Nullable - for failed login attempts
  user      users?      @relation(fields: [user_id], references: [id], onDelete: SetNull)
  status    LoginStatus @default(SUCCESS)
  ip_address String?
  user_agent String?
  attempted_email String? // For tracking failed login attempts
  created_at DateTime   @default(now())

  @@index([user_id])
  @@index([created_at])
  @@map("login_audits")
}